{
  "name": "@mach25/find-elements",
  "type": "module",
  "private": false,
  "version": "2.1.0",
  "description": "Utility to find elements on a web page using selector functions and a timeout",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./select": {
      "types": "./lib/select.d.ts",
      "default": "./lib/select.js"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mach25/find-elements.git"
  },
  "bugs": {
    "url": "https://github.com/mach25/find-elements/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
